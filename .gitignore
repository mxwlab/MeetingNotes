# Python 虚拟环境（体积大，另行 pip 安装）
venv/
__pycache__/
*.pyc

# 本地大模型（whisper ~3GB，另行下载，见 README）
models/

# 第三方 FluidAudio 及其编译产物（见 fluidaudio-patch/SETUP.md 重建）
tools/

# 运行时状态与日志
logs/
.pet_state
.watch.lock
.dl.lock

# 个人录音与生成的纪要（保留目录结构，不上传内容）
inbox/*
output/*
done/*
!inbox/.gitkeep
!output/.gitkeep
!done/.gitkeep

# 音频文件 / macOS
*.m4a
*.mp3
*.wav
*.mp4
*.aac
*.flac
.DS_Store
