# Python 虚拟环境（体积大，另行 pip 安装）
venv/
venv-ui/
__pycache__/
*.pyc

# 本地大模型（whisper ~3GB，另行下载，见 README）
models/

# 第三方 FluidAudio 及其编译产物（见 fluidaudio-patch/SETUP.md 重建）
tools/
dist/
tmp/

# 运行时状态与日志
logs/
.pet_state
.menubar_label
.watch.lock
.dl.lock

# 本地配置（用户特定的 API 密钥等）
config.local.sh

# 个人录音与生成的纪要（保留目录结构，不上传内容）
inbox/*
output/*
done/*
skipped/*
!inbox/.gitkeep
!output/.gitkeep
!done/.gitkeep

# 音频文件 / macOS
*.m4a
*.mp3
*.wav
*.mp4
*.aac
*.flac
!tests/fixtures/tiny.wav
.DS_Store
glossary.local.txt
people.local.txt

# 品牌图标/吉祥物探索稿（最终采用 assets/meetingnotes-icon.png，候选变体不入库）
assets/meetingnotes-icon-*.png
assets/meetingnotes-mascot-*.png
